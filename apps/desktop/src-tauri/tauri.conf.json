{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aegon",
  "version": "0.1.0",
  "identifier": "com.crisd404.aegon",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": "pnpm --filter @aegon/web dev",
    "beforeBuildCommand": "pnpm --filter @aegon/web build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aegon",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Diagramas C4 como código",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
